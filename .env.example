APP_NAME=DJ Khaled
DISCORD_TOKEN=
CLIENT_ID=
# Comma-separated server IDs; leave empty for global commands.
GUILD_ID=
DEFAULT_VOLUME=100
# Decode ahead to absorb brief FFmpeg stalls (100-5000 ms).
AUDIO_BUFFER_MS=1000
MAX_QUEUE_SIZE=100
MAX_PLAYLIST_SIZE=50
# Download the next tracks ahead; sequential playback also prepares the next decoder.
PREFETCH_TRACKS=2
IDLE_TIMEOUT=300
ALONE_TIMEOUT=120
CACHE_MAX_MB=1024
MAX_DOWNLOAD_MB=256
# Optional external programs; otherwise discovered on PATH.
FFMPEG_PATH=
DENO_PATH=
# Public Spotify song links work without API keys when public metadata is available.
# API credentials enable the API path; collection access also depends on Spotify app permissions.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Register this exact callback in the Spotify app, then run dj-khaled --spotify-login.
# User sign-in is required for development-app playlists owned by/collaborative with that account.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional Genius lyrics credentials; otherwise lyrics use LRCLIB.
GENIUS_ACCESS_TOKEN=
SPOTIFY_MARKET=GB
# Optional authentication for YouTube.
COOKIES_FILE=
COOKIES_FROM_BROWSER=
YOUTUBE_PO_TOKEN=
# Optional HTTP login-status check; 0 disables it. Restart after changing.
YOUTUBE_STATUS_HOST=127.0.0.1
YOUTUBE_STATUS_PORT=0
YTDLP_PROXY_HOST=
YTDLP_PROXY_PORT=
YTDLP_PROXY_USERNAME=
YTDLP_PROXY_PASSWORD=
# Optional comma-separated Discord role IDs. Otherwise an exact DJ role name is used.
DJ_ROLE_IDS=
# Optional fixed shard count; empty lets discord.py choose.
TOTAL_SHARDS=
# Set false to keep the existing Discord bot account username.
SYNC_BOT_NAME=true
